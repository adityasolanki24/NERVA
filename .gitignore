# Python
__pycache__/
*.pyc
.venv/
nerva_env/

# Runtime artefacts written by upstream Open Duck scripts
mujoco_saved_obs.pkl

# Upstream Open Duck repos are cloned separately (see README), never vendored here
open_duck/

# Build / test artefacts
*.egg-info/
.pytest_cache/

# Cloud run outputs (large; summaries are copied into experiment folders)
experiments/cloud_runs/
.nerva-code-*.tar.gz

# Local configuration and credentials must never be committed
.env
.env.*
!.env.example
cloud/config.local.*
application_default_credentials.json
*service-account*.json
*.pem
*.key
*.p12
*.pfx

# Keep third-party papers as local research material unless redistribution is licensed
docs/papers/*.pdf
experiments/reactive/results*/

# Demo outputs are regenerated (videos are large); the current demo is rendered in the cloud
experiments/demo_video/results*/
